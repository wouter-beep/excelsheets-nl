# ─── ExcelSheets.nl · omgevingsvariabelen ───────────────────────────────
# Kopieer naar .env (lokaal) of zet ze in je hostingomgeving. Nooit committen.

# Website
NEXT_PUBLIC_SITE_URL="https://www.excelsheets.nl"
# Zet pas op "true" in de echte productieomgeving. Anders vraagt robots.txt zoekmachines om niets te indexeren.
SITE_INDEXABLE="false"

# Database. Lokaal: SQLite. Productie: PostgreSQL (zet dan in prisma/schema.prisma provider = "postgresql").
DATABASE_URL="file:./dev.db"
# DATABASE_URL="postgresql://gebruiker:wachtwoord@host:5432/excelsheets?sslmode=require"

# Beheer: lange willekeurige sleutel (min. 32 tekens), bv. `openssl rand -base64 48`
AUTH_SECRET=""
# Eerste eigenaar-account (wordt aangemaakt door `npm run db:seed`)
ADMIN_EMAIL=""
ADMIN_PASSWORD=""
ADMIN_NAME=""

# E-mail via SMTP. Zonder SMTP_HOST draait e-mail in demomodus (opslag in storage/private/outbox).
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASS=""
EMAIL_FROM="ExcelSheets.nl <aanvragen@excelsheets.nl>"
# Ontvangers van meldingen bij nieuwe aanvragen (ook in te stellen in beheer > Instellingen)
ADMIN_NOTIFY_EMAILS=""

# Opslag voor geüploade bestanden (buiten de webroot, persistent volume, back-ups versleuteld)
STORAGE_DIR=""
UPLOAD_MAX_MB="15"
NEXT_PUBLIC_UPLOAD_MAX_MB="15"

# Virusscan via ClamAV (clamd). In productie is scannen verplicht tenzij MALWARE_SCAN_REQUIRED=false.
CLAMAV_HOST=""
CLAMAV_PORT="3310"
MALWARE_SCAN_REQUIRED=""

# Optioneel: Cloudflare Turnstile botbescherming
NEXT_PUBLIC_TURNSTILE_SITE_KEY=""
TURNSTILE_SECRET_KEY=""

# Bewaartermijnen (ook in beheer aan te passen)
RETENTION_ATTACHMENT_DAYS="90"
RETENTION_REQUEST_DAYS="365"

# Bedrijfsgegevens: alleen invullen met echte gegevens (ook in beheer aan te passen)
COMPANY_LEGAL_NAME=""
COMPANY_KVK=""
COMPANY_VAT=""
CONTACT_EMAIL=""
CONTACT_PHONE=""
COMPANY_ADDRESS=""
